set(CPACK_PACKAGE_NAME 8bitshell)
set(CPACK_PACKAGE_VENDOR "8bitPrograms")
set(CPACK_WIX_PROGRAM_MENU_FOLDER "8bitPrograms")
set(CPACK_PACKAGE_CONTACT "https://github.com/8bitPrograms/8bitShell/issues")
set(CPACK_PACKAGE_HOMEPAGE_URL "${PROJECT_HOMEPAGE_URL}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "8bitShell terminal and remote access workspace")
set(CPACK_PACKAGE_DESCRIPTION "Qt Quick terminal workspace with OpenSSH sessions, SFTP, readable YAML catalogs, macros and logging.")
set(CPACK_RPM_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION}")
set(CPACK_DEBIAN_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION}")
set(CPACK_RPM_PACKAGE_GROUP "Applications/Internet")
set(CPACK_PACKAGE_RELOCATABLE OFF)
set(CPACK_RPM_PACKAGE_RELOCATABLE OFF)
set(CPACK_PACKAGE_VERSION "${BIT8SHELL_VERSION}")
set(CPACK_PACKAGE_VERSION_MAJOR "${PROJECT_VERSION_MAJOR}")
set(CPACK_PACKAGE_VERSION_MINOR "${PROJECT_VERSION_MINOR}")
set(CPACK_PACKAGE_VERSION_PATCH "${PROJECT_VERSION_PATCH}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY 8bitShell)
set(CPACK_PACKAGE_EXECUTABLES 8bitShell 8bitShell)
set(CPACK_CREATE_DESKTOP_LINKS 8bitShell)
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_STRIP_FILES TRUE)
set(CPACK_PACKAGE_CHECKSUM SHA256)
if(EXISTS "${PROJECT_SOURCE_DIR}/LICENSE")
    configure_file("${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_BINARY_DIR}/PackageLicense.txt" COPYONLY)
    install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_INSTALL_DOCDIR}")
else()
    configure_file(packaging/RELEASE-NOTICE.txt "${PROJECT_BINARY_DIR}/PackageLicense.txt" COPYONLY)
    install(FILES packaging/RELEASE-NOTICE.txt DESTINATION "${CMAKE_INSTALL_DOCDIR}")
endif()
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_BINARY_DIR}/PackageLicense.txt")

# No guessed open-source license: the release preflight blocks publication while
# this is unset. Local packages remain explicitly labelled evaluation builds.
file(READ "${PROJECT_SOURCE_DIR}/packaging/release-policy.json" _release_policy)
string(JSON BIT8SHELL_LICENSE_EXPRESSION GET "${_release_policy}" licenseExpression)
set(CPACK_RPM_PACKAGE_LICENSE "${BIT8SHELL_LICENSE_EXPRESSION} AND MIT")
set(CPACK_DEBIAN_PACKAGE_VERSION "${BIT8SHELL_UNIX_VERSION}")
set(CPACK_DEBIAN_PACKAGE_RELEASE 1)
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "blueberi99 <308130711+blueberi99@users.noreply.github.com>")
set(CPACK_DEBIAN_PACKAGE_SECTION utils)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "openssh-client")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_RPM_PACKAGE_VERSION "${BIT8SHELL_UNIX_VERSION}")
set(CPACK_RPM_PACKAGE_RELEASE 1)
set(CPACK_RPM_PACKAGE_RELEASE_DIST ON)
set(CPACK_RPM_PACKAGE_REQUIRES "openssh-clients, qt6-qtdeclarative >= 6.7, qt6-qtsvg, qt6-qtwayland")
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
    /usr/share/metainfo /usr/share/icons /usr/share/icons/hicolor
    /usr/share/icons/hicolor/scalable /usr/share/icons/hicolor/scalable/apps)

if(WIN32)
    set(CPACK_GENERATOR ZIP)
    set(CPACK_WIX_VERSION 4)
    # 8bitShell has its own Windows product identity instead of inheriting the
    # previous pre-release package identity.
    set(CPACK_WIX_UPGRADE_GUID "E652F7A6-9E2C-4F10-84E0-6477E13A3485")
    set(CPACK_WIX_ARCHITECTURE x64)
    set(CPACK_WIX_INSTALL_SCOPE perUser)
    set(CPACK_WIX_PRODUCT_ICON "${PROJECT_SOURCE_DIR}/assets/bitshell.ico")
    set(CPACK_WIX_PROPERTY_ARPURLINFOABOUT "${PROJECT_HOMEPAGE_URL}")
    set(CPACK_SYSTEM_NAME windows-x64)
else()
    set(CPACK_SYSTEM_NAME "linux-${CMAKE_SYSTEM_PROCESSOR}")
    if(BIT8SHELL_BUNDLE_RUNTIME)
        set(CPACK_GENERATOR TGZ)
    else()
        set(CPACK_GENERATOR RPM)
        string(APPEND CPACK_DEBIAN_PACKAGE_DEPENDS ", qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-dialogs, qml6-module-qtquick-layouts, qml6-module-qtquick-window, qml6-module-qtquick-templates, qml6-module-qtqml-workerscript")
    endif()
endif()
configure_file(cmake/CPackOptions.cmake.in "${PROJECT_BINARY_DIR}/CPackOptions.cmake" @ONLY)
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_BINARY_DIR}/CPackOptions.cmake")
set(CPACK_PACKAGE_FILE_NAME "8bitShell-${BIT8SHELL_VERSION}-${CPACK_SYSTEM_NAME}")
include(CPack)
