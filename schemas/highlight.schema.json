{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitshell.local/schemas/highlight.schema.json",
  "title": "8bitShell terminal highlight profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profiles"],
  "properties": {
    "schema": { "const": 1 },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "pattern", "style"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
                "name": { "type": "string" },
                "enabled": { "type": "boolean", "default": true },
                "pattern": { "type": "string", "minLength": 1 },
                "case_sensitive": { "type": "boolean", "default": false },
                "priority": { "type": "integer", "default": 0 },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "foreground": { "$ref": "#/$defs/color" },
                    "background": { "$ref": "#/$defs/color" },
                    "bold": { "type": "boolean" },
                    "underline": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    }
  }
}

