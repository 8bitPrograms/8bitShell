include(CheckCXXCompilerFlag)

option(BIT8SHELL_ENABLE_SANITIZERS "Instrument application code with AddressSanitizer and UBSan" OFF)
if(WIN32)
    add_compile_definitions(WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE _WIN32_WINNT=0x0A00)
    if(MSVC)
        add_compile_options(/utf-8 /GS /sdl /guard:cf)
        add_link_options(/DYNAMICBASE /HIGHENTROPYVA /NXCOMPAT /guard:cf)
        if(BIT8SHELL_ENABLE_SANITIZERS)
            add_compile_options(/fsanitize=address /Zi)
            add_link_options(/DEBUG /INCREMENTAL:NO)
        endif()
    else()
        message(FATAL_ERROR "Windows builds currently require the tested MSVC toolchain.")
    endif()
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    # Native Linux packages use the system loader's trusted library locations.
    # Qt's default install RPATH can otherwise leave empty (CWD) padding entries
    # in the build-tree executable before installation.
    if(BIT8SHELL_BUNDLE_RUNTIME)
        # A portable build must find its replaceable libraries beside itself.
        # Never inject CWD, an empty path, or a global LD_LIBRARY_PATH wrapper.
        set(CMAKE_SKIP_RPATH FALSE)
        set(CMAKE_BUILD_RPATH_USE_ORIGIN TRUE)
        set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
    else()
        set(CMAKE_SKIP_RPATH TRUE)
    endif()
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    foreach(flag IN ITEMS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full)
        string(MAKE_C_IDENTIFIER "${flag}" test_name)
        check_cxx_compiler_flag("${flag}" "BIT8SHELL_HAS_${test_name}")
        if(BIT8SHELL_HAS_${test_name})
            add_compile_options("${flag}")
        endif()
    endforeach()
    add_compile_definitions($<$<NOT:$<CONFIG:Debug>>:_FORTIFY_SOURCE=3>)
    add_link_options(-Wl,-z,relro,-z,now,-z,noexecstack)
    if(BIT8SHELL_ENABLE_SANITIZERS)
        add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer)
        add_link_options(-fsanitize=address,undefined)
    endif()
endif()
