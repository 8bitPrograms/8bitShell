# Only the installed copy is changed. The build-tree executable/tests continue
# to resolve the reviewed SDK; no loader environment variable is introduced.
file(RPATH_CHANGE
    FILE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/bitshell"
    OLD_RPATH "@BIT8SHELL_BUILD_APP_RPATH@"
    NEW_RPATH "$ORIGIN/../@CMAKE_INSTALL_LIBDIR@")
