# One release identifier shared by the UI, binaries, package names and Git tags.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../PROJECT_VERSION" BIT8SHELL_VERSION)
if(NOT BIT8SHELL_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\\.([1-9][0-9]*))?$")
    message(FATAL_ERROR "PROJECT_VERSION must be X.Y.Z or X.Y.Z-(alpha|beta|rc).N")
endif()
set(BIT8SHELL_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(BIT8SHELL_VERSION_MINOR "${CMAKE_MATCH_2}")
set(BIT8SHELL_VERSION_PATCH "${CMAKE_MATCH_3}")
set(BIT8SHELL_PRERELEASE "${CMAKE_MATCH_4}")
set(BIT8SHELL_CHANNEL "${CMAKE_MATCH_5}")
set(BIT8SHELL_PRERELEASE_NUMBER "${CMAKE_MATCH_6}")
set(BIT8SHELL_VERSION_CORE "${BIT8SHELL_VERSION_MAJOR}.${BIT8SHELL_VERSION_MINOR}.${BIT8SHELL_VERSION_PATCH}")
if(BIT8SHELL_VERSION_MAJOR GREATER 255 OR BIT8SHELL_VERSION_MINOR GREATER 255 OR BIT8SHELL_VERSION_PATCH GREATER 64
   OR (BIT8SHELL_PRERELEASE AND BIT8SHELL_PRERELEASE_NUMBER GREATER 99))
    message(FATAL_ERROR "MSI mapping allows major/minor <=255, patch <=64 and preview counter 1..99")
endif()
set(_bitshell_slot 999)
if(BIT8SHELL_CHANNEL STREQUAL "alpha")
    math(EXPR _bitshell_slot "100 + ${BIT8SHELL_PRERELEASE_NUMBER}")
elseif(BIT8SHELL_CHANNEL STREQUAL "beta")
    math(EXPR _bitshell_slot "300 + ${BIT8SHELL_PRERELEASE_NUMBER}")
elseif(BIT8SHELL_CHANNEL STREQUAL "rc")
    math(EXPR _bitshell_slot "600 + ${BIT8SHELL_PRERELEASE_NUMBER}")
endif()
math(EXPR _bitshell_msi_build "${BIT8SHELL_VERSION_PATCH} * 1000 + ${_bitshell_slot}")
set(BIT8SHELL_MSI_VERSION "${BIT8SHELL_VERSION_MAJOR}.${BIT8SHELL_VERSION_MINOR}.${_bitshell_msi_build}")
if(BIT8SHELL_VERSION_MAJOR GREATER_EQUAL 1)
    if(BIT8SHELL_PRERELEASE)
        message(FATAL_ERROR "Public 1.x releases use stable three-part versions")
    endif()
    set(_bitshell_msi_build "${BIT8SHELL_VERSION_PATCH}")
    set(BIT8SHELL_MSI_VERSION "${BIT8SHELL_VERSION_CORE}")
endif()
string(REPLACE "-" "~" BIT8SHELL_UNIX_VERSION "${BIT8SHELL_VERSION}")
