# Evaluated by CPack once per selected generator, not at configure time.
if(CPACK_GENERATOR STREQUAL "WIX")
    set(CPACK_PACKAGE_NAME 8bitShell)
    set(CPACK_PACKAGE_VERSION "@BIT8SHELL_MSI_VERSION@")
    set(CPACK_PACKAGE_FILE_NAME "bitshell-@BIT8SHELL_VERSION@-windows-x64")
elseif(CPACK_GENERATOR STREQUAL "DEB" OR CPACK_GENERATOR STREQUAL "RPM")
    if(CPACK_GENERATOR STREQUAL "DEB")
        # CPack otherwise warns and can omit automatic runtime dependencies.
        # Incomplete dependency metadata must never become a release package.
        find_program(BIT8SHELL_DPKG_DEB dpkg-deb REQUIRED)
        find_program(BIT8SHELL_DPKG_SHLIBDEPS dpkg-shlibdeps REQUIRED)
    endif()
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    if(@BIT8SHELL_BUNDLE_RUNTIME@)
        if(CPACK_GENERATOR STREQUAL "RPM")
            message(FATAL_ERROR "Build RPM natively on Fedora with BIT8SHELL_BUNDLE_RUNTIME=OFF")
        endif()
        set(CPACK_PACKAGING_INSTALL_PREFIX /opt/bitshell)
        set(CPACK_PRE_BUILD_SCRIPTS "@PROJECT_SOURCE_DIR@/cmake/StageBundledDeb.cmake")
    endif()
elseif(CPACK_GENERATOR STREQUAL "TGZ")
    set(CPACK_PACKAGING_INSTALL_PREFIX /)
    if(@BIT8SHELL_BUNDLE_RUNTIME@)
        set(CPACK_PACKAGE_FILE_NAME "bitshell-@BIT8SHELL_VERSION@-linux-x86_64-portable")
    else()
        set(CPACK_PACKAGE_FILE_NAME "bitshell-@BIT8SHELL_VERSION@-linux-x86_64-system-qt")
    endif()
endif()
